# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Generated application output and local configuration
output/
config/local.json
config.local.json
*.tmp
*.bak

# Internal review material: original drafts, extracted text and page renders.
.review/

# LaTeX build products. Final academic PDFs remain versionable.
*.aux
*.bbl
*.blg
*.brf
*.fls
*.fdb_latexmk
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc

# Raw Nmap output can expose sensitive infrastructure. Only reviewed,
# explicitly synthetic fixtures under examples/ and tests/ belong in Git.
*.xml
!examples/**/*.xml
!tests/fixtures/**/*.xml
